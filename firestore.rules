rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Helpers
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomId(roomId) {
      return roomId is string && roomId.size() == 64 && roomId.matches('^[a-f0-9]{64}$');
    }

    function isValidUsernameKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 20 && key.matches('^[a-z0-9._\\-]{3,20}$');
    }

    function isValidUsernameValue(val) {
      return val is string && val.size() >= 3 && val.size() <= 20 && val.matches('^[a-zA-Z0-9._\\-]{3,20}$');
    }

    function isRoomMember(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }

    function isRoomActive(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      return exists(roomPath) && (!('status' in get(roomPath).data) || get(roomPath).data.status == 'active');
    }

    function isRoomActiveAfter(roomId) {
      let roomPath = /databases/$(database)/documents/rooms/$(roomId);
      return existsAfter(roomPath) && (!('status' in getAfter(roomPath).data) || getAfter(roomPath).data.status == 'active');
    }

    function isValidRoomRole(roomId, role) {
      let roomData = getAfter(/databases/$(database)/documents/rooms/$(roomId)).data;
      return (role == 'owner' && roomData.createdBy == request.auth.uid)
        || (role == 'member' && roomData.createdBy != request.auth.uid);
    }

    function ownsClaimedUsername(username) {
      let key = username.lower();
      return isValidUsernameKey(key)
        && getAfter(/databases/$(database)/documents/usernames/$(key)).data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------

    function isValidUsernameDoc(data, key) {
      return data.keys().hasAll(['uid', 'username', 'normalizedUsername', 'createdAt'])
        && data.keys().hasOnly(['uid', 'username', 'normalizedUsername', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && isValidUsernameValue(data.username)
        && data.normalizedUsername is string
        && data.normalizedUsername == key
        && data.username.lower() == key
        && data.createdAt is timestamp;
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'username', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 24 && data.displayName.trim().size() >= 2
        && (!('username' in data) || isValidUsernameValue(data.username))
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRecentRoom(data, userId, roomId) {
      return data.keys().hasAll(['uid', 'roomId', 'normalizedName', 'lastVisitedAt'])
        && data.keys().hasOnly([
          'uid',
          'roomId',
          'roomName',
          'name',
          'normalizedName',
          'ownerUid',
          'ownerUsername',
          'role',
          'lastVisitedAt',
          'lastReadAt',
          'createdAt'
        ])
        && data.uid is string && data.uid == userId && data.uid == request.auth.uid
        && data.roomId is string && data.roomId == roomId
        && (!('roomName' in data) || (data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 40 && data.roomName.trim().size() >= 1))
        && (!('name' in data) || (data.name is string && data.name.size() >= 1 && data.name.size() <= 40 && data.name.trim().size() >= 1))
        && ('roomName' in data || 'name' in data)
        && data.normalizedName is string && data.normalizedName.size() >= 1 && data.normalizedName.size() <= 40
        && (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128))
        && (!('ownerUsername' in data) || (data.ownerUsername is string && data.ownerUsername.size() <= 24))
        && (!('role' in data) || data.role in ['owner', 'member'])
        && data.lastVisitedAt is timestamp
        && (!('lastReadAt' in data) || data.lastReadAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    function isValidRoom(data, roomId) {
      return data.keys().hasAll(['roomId', 'name', 'normalizedName', 'createdBy', 'createdAt'])
        && data.keys().hasOnly([
          'roomId',
          'name',
          'normalizedName',
          'createdBy',
          'createdByUsername',
          'createdByDisplayName',
          'createdAt',
          'status'
        ])
        && data.roomId is string && data.roomId == roomId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40 && data.name.trim().size() >= 1
        && data.normalizedName is string && data.normalizedName.size() >= 1 && data.normalizedName.size() <= 40
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && (!('createdByUsername' in data) || isValidUsernameValue(data.createdByUsername))
        && (!('createdByDisplayName' in data) || (data.createdByDisplayName is string && data.createdByDisplayName.size() >= 2 && data.createdByDisplayName.size() <= 24))
        && data.createdAt is timestamp
        && (!('status' in data) || data.status in ['active', 'deleting']);
    }

    function isValidMember(data, roomId, memberId) {
      return data.keys().hasAll(['uid', 'roomId', 'displayName', 'photoURL', 'joinedAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'displayName', 'username', 'photoURL', 'role', 'joinedAt', 'lastMessageAt'])
        && data.uid is string && data.uid == memberId && data.uid == request.auth.uid
        && data.roomId is string && data.roomId == roomId
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 24 && data.displayName.trim().size() >= 2
        && (!('username' in data) || isValidUsernameValue(data.username))
        && data.photoURL is string && data.photoURL.size() <= 500
        && (!('role' in data) || data.role in ['owner', 'member'])
        && data.joinedAt is timestamp
        && (!('lastMessageAt' in data) || data.lastMessageAt is timestamp);
    }

    function isValidMessage(data, roomId, messageId) {
      return data.keys().hasAll(['messageId', 'roomId', 'senderId', 'senderName', 'senderPhotoURL', 'text', 'createdAt'])
        && data.keys().hasOnly(['messageId', 'roomId', 'senderId', 'senderName', 'senderUsername', 'senderPhotoURL', 'text', 'createdAt'])
        && data.messageId is string && data.messageId == messageId
        && data.roomId is string && data.roomId == roomId
        && data.senderId is string && data.senderId == request.auth.uid
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 24
        && (!('senderUsername' in data) || isValidUsernameValue(data.senderUsername))
        && data.senderPhotoURL is string && data.senderPhotoURL.size() <= 500
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 && data.text.trim().size() >= 1
        && data.createdAt is timestamp;
    }

    function isMessageCooldownElapsed(roomId) {
      let memberDoc = get(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data;
      return !('lastMessageAt' in memberDoc)
        || request.time >= memberDoc.lastMessageAt + duration.value(500, 'ms');
    }

    function hasAtomicMemberLastMessageUpdate(roomId) {
      let afterMember = getAfter(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)).data;
      return afterMember.lastMessageAt == request.time;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------

    match /usernames/{normalizedUsername} {
      // Single-document availability lookup allowed for signed-in users; scraping list forbidden
      allow get: if isSignedIn() && isValidUsernameKey(normalizedUsername);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidUsernameKey(normalizedUsername)
        && isValidUsernameDoc(incoming(), normalizedUsername)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidUsernameKey(normalizedUsername)
        && existing().uid == request.auth.uid;
    }

    match /users/{userId} {
      // PII isolated strictly to profile owner
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && (!('username' in incoming()) || ownsClaimedUsername(incoming().username))
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUser(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'photoURL', 'updatedAt'])
        && (
          !('username' in incoming())
          || (('username' in existing()) && incoming().username == existing().username)
          || ownsClaimedUsername(incoming().username)
        );

      allow delete: if false;

      match /recentRooms/{roomId} {
        // Recent room history belongs strictly to the user and NEVER depends on active membership
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidRoomId(roomId)
          && request.auth.uid == userId;

        allow list: if isSignedIn()
          && isValidId(userId)
          && request.auth.uid == userId;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidRoomId(roomId)
          && request.auth.uid == userId
          && isValidRecentRoom(incoming(), userId, roomId)
          && incoming().lastVisitedAt == request.time
          && existsAfter(/databases/$(database)/documents/rooms/$(roomId))
          && (!('role' in incoming()) || isValidRoomRole(roomId, incoming().role));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidRoomId(roomId)
          && request.auth.uid == userId
          && isValidRecentRoom(incoming(), userId, roomId)
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && (incoming().lastVisitedAt == request.time || incoming().lastVisitedAt == existing().lastVisitedAt)
          && (!('lastReadAt' in incoming()) || incoming().lastReadAt == request.time)
          && (!('role' in incoming()) || isValidRoomRole(roomId, incoming().role))
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'roomName',
            'name',
            'normalizedName',
            'ownerUid',
            'ownerUsername',
            'role',
            'lastVisitedAt',
            'lastReadAt',
            'createdAt'
          ]);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidRoomId(roomId)
          && request.auth.uid == userId;
      }
    }

    match /rooms/{roomId} {
      // Single-room lookup by deterministic SHA-256 ID allowed for authenticated users; listing forbidden
      allow get: if isSignedIn() && isValidRoomId(roomId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidRoomId(roomId)
        && isValidRoom(incoming(), roomId)
        && incoming().createdBy == request.auth.uid
        && 'createdByUsername' in incoming()
        && 'createdByDisplayName' in incoming()
        && 'status' in incoming()
        && incoming().status == 'active'
        && incoming().createdAt == request.time;

      // Only the immutable creator can backfill missing creator display metadata; ownership and status are immutable from client
      allow update: if isVerifiedUser()
        && isValidRoomId(roomId)
        && existing().createdBy == request.auth.uid
        && isValidRoom(incoming(), roomId)
        && incoming().roomId == existing().roomId
        && incoming().name == existing().name
        && incoming().normalizedName == existing().normalizedName
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['createdByUsername', 'createdByDisplayName']);

      // Direct client deletion strictly denied; permanent deletion must run through trusted Cloud Function Admin SDK
      allow delete: if false;

      match /members/{memberId} {
        allow get: if isSignedIn()
          && isValidRoomId(roomId)
          && isValidId(memberId)
          && (request.auth.uid == memberId || isRoomMember(roomId));

        allow list: if isSignedIn()
          && isValidRoomId(roomId)
          && isRoomMember(roomId);

        allow create: if isVerifiedUser()
          && isValidRoomId(roomId)
          && isValidId(memberId)
          && request.auth.uid == memberId
          && isValidMember(incoming(), roomId, memberId)
          && incoming().joinedAt == request.time
          && !('lastMessageAt' in incoming())
          && isRoomActiveAfter(roomId)
          && (!('role' in incoming()) || isValidRoomRole(roomId, incoming().role));

        allow update: if isVerifiedUser()
          && isValidRoomId(roomId)
          && isValidId(memberId)
          && request.auth.uid == memberId
          && isValidMember(incoming(), roomId, memberId)
          && isRoomActive(roomId)
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().joinedAt == existing().joinedAt
          && (!('role' in incoming()) || isValidRoomRole(roomId, incoming().role))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'username', 'photoURL', 'role'])
            || (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'displayName', 'username', 'photoURL', 'role'])
              && incoming().lastMessageAt == request.time
              && (!('lastMessageAt' in existing()) || request.time >= existing().lastMessageAt + duration.value(500, 'ms'))
            )
          );

        allow delete: if isVerifiedUser()
          && isValidRoomId(roomId)
          && isValidId(memberId)
          && request.auth.uid == memberId;
      }

      match /messages/{messageId} {
        allow get: if isSignedIn()
          && isValidRoomId(roomId)
          && isValidId(messageId)
          && isRoomMember(roomId);

        allow list: if isSignedIn()
          && isValidRoomId(roomId)
          && isRoomMember(roomId);

        allow create: if isVerifiedUser()
          && isValidRoomId(roomId)
          && isValidId(messageId)
          && isValidMessage(incoming(), roomId, messageId)
          && incoming().createdAt == request.time
          && isRoomActive(roomId)
          && isRoomMember(roomId)
          && isMessageCooldownElapsed(roomId)
          && hasAtomicMemberLastMessageUpdate(roomId);

        allow update, delete: if false;
      }
    }
  }
}
