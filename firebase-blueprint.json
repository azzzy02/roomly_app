{
  "entities": {
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Globally unique case-insensitive username reservation record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated UID of the user who owns this username",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "description": "User's chosen username preserving original casing",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9._\\-]{3,20}$"
        },
        "normalizedUsername": {
          "type": "string",
          "description": "Lowercase normalized username matching document ID",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-z0-9._\\-]{3,20}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when username was claimed"
        }
      },
      "required": [
        "uid",
        "username",
        "normalizedUsername",
        "createdAt"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile stored in Firestore",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase authenticated user ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "User's chosen display name",
          "minLength": 2,
          "maxLength": 24
        },
        "username": {
          "type": "string",
          "description": "Globally unique username",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9._\\-]{3,20}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's verified Google account email (owner-only)",
          "minLength": 3,
          "maxLength": 254
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL or empty string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "photoURL",
        "createdAt",
        "updatedAt"
      ]
    },
    "RecentRoom": {
      "title": "RecentRoom",
      "description": "A user's persistent personal room history independent of active membership",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Owner user ID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "description": "Deterministic SHA-256 hash of normalized room name",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "roomName": {
          "type": "string",
          "description": "Original display name of the room",
          "minLength": 1,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "description": "Room display name (legacy alias)",
          "minLength": 1,
          "maxLength": 40
        },
        "normalizedName": {
          "type": "string",
          "description": "Normalized lowercase room name",
          "minLength": 1,
          "maxLength": 40
        },
        "ownerUid": {
          "type": "string",
          "description": "Authoritative UID of room creator or legacy marker",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUsername": {
          "type": "string",
          "description": "Username of room creator",
          "maxLength": 24
        },
        "role": {
          "type": "string",
          "enum": ["owner", "member"],
          "description": "User role in the room"
        },
        "lastVisitedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user last opened the room"
        },
        "lastReadAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of user's last read position"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Room creation timestamp"
        }
      },
      "required": [
        "uid",
        "roomId",
        "roomName",
        "normalizedName",
        "ownerUid",
        "ownerUsername",
        "role",
        "lastVisitedAt",
        "lastReadAt",
        "createdAt"
      ]
    },
    "Room": {
      "title": "Room",
      "description": "A chat room identified by deterministic SHA-256 hash of its normalized name",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Deterministic SHA-256 hash of normalized room name",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "description": "Original trimmed display name of the room",
          "minLength": 1,
          "maxLength": 40
        },
        "normalizedName": {
          "type": "string",
          "description": "Unicode NFKC normalized, whitespace-collapsed, lowercased room name",
          "minLength": 1,
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "description": "Immutable UID of the user who created the room",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdByUsername": {
          "type": "string",
          "description": "Unique username of the room creator",
          "minLength": 3,
          "maxLength": 20
        },
        "createdByDisplayName": {
          "type": "string",
          "description": "Display name of the room creator at creation time",
          "minLength": 2,
          "maxLength": 24
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when room was created"
        },
        "status": {
          "type": "string",
          "enum": ["active", "deleting"],
          "description": "Lifecycle status of the room"
        }
      },
      "required": [
        "roomId",
        "name",
        "normalizedName",
        "createdBy",
        "createdByUsername",
        "createdByDisplayName",
        "createdAt",
        "status"
      ]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "Active room membership record granting read and message write access",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Member Firebase authenticated UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "description": "Parent room SHA-256 ID",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "displayName": {
          "type": "string",
          "description": "Member display name",
          "minLength": 2,
          "maxLength": 24
        },
        "username": {
          "type": "string",
          "description": "Member unique username",
          "minLength": 3,
          "maxLength": 20
        },
        "photoURL": {
          "type": "string",
          "description": "Member avatar URL or empty string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["owner", "member"],
          "description": "Authoritative role derived from room creator"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user joined the room"
        },
        "lastMessageAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the member's most recent message for rate limiting"
        }
      },
      "required": [
        "uid",
        "roomId",
        "displayName",
        "username",
        "photoURL",
        "role",
        "joinedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A real-time chat message stored in a room's messages subcollection",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique client-generated ID for idempotent message creation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "description": "Parent room SHA-256 ID",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "senderId": {
          "type": "string",
          "description": "Authenticated UID of the sender",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender at send time",
          "minLength": 2,
          "maxLength": 24
        },
        "senderUsername": {
          "type": "string",
          "description": "Unique username of the sender at send time",
          "minLength": 3,
          "maxLength": 20
        },
        "senderPhotoURL": {
          "type": "string",
          "description": "Avatar URL of the sender at send time",
          "maxLength": 500
        },
        "text": {
          "type": "string",
          "description": "Message text content",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-generated timestamp when message was persisted"
        }
      },
      "required": [
        "messageId",
        "roomId",
        "senderId",
        "senderName",
        "senderUsername",
        "senderPhotoURL",
        "text",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/usernames/{normalizedUsername}": {
      "schema": {
        "$ref": "#/entities/UsernameClaim"
      },
      "description": "Unique username reservation registry"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profiles isolated by owner UID"
    },
    "/users/{userId}/recentRooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/RecentRoom"
      },
      "description": "User's persistent personal room history independent of active membership"
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/Room"
      },
      "description": "Chat rooms keyed by SHA-256 hash of normalized room name"
    },
    "/rooms/{roomId}/members/{memberId}": {
      "schema": {
        "$ref": "#/entities/RoomMember"
      },
      "description": "Active room membership records and per-user message rate-limit state"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/ChatMessage"
      },
      "description": "Immutable chat messages isolated per room"
    }
  }
}
